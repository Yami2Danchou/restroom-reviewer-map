generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or "sqlite" for development
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviews       Review[]
  pendingPlaces PendingPlace[]
  places        Place[]   // Places directly added by admin
}

model Place {
  id          String   @id @default(cuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  address     String?
  createdById String?  // If null, it was approved from pending
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reviews     Review[]
  photos      Photo[]
}

model Photo {
  id        String   @id @default(cuid())
  url       String   // URL of the uploaded image
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id])
  uploadedById String
  uploadedBy User    @relation(fields: [uploadedById], references: [id])
  createdAt DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  comment     String?
  smellLevel  Int      // 1-10 scale for smell intensity
  placeId     String
  place       Place    @relation(fields: [placeId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PendingPlace {
  id          String   @id @default(cuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  address     String?
  status      String   @default("pending") // pending, approved, rejected
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}