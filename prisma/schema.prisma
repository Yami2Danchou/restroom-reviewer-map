generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reviews       Review[]
  suggestions   Suggestion[]
  photos        Photo[]
  createdPlaces Place[]   @relation("CreatedPlaces")
}

model Place {
  id          String    @id @default(cuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  address     String?
  city        String
  district    String?   // Specific area/district in Davao
  barangay    String?   // Barangay level
  category    String?   // Mall, Park, Public, etc.
  amenities   Json?     // Store amenities as JSON (hasWheelchair, hasBidet, etc.)
  status      String    @default("active") // active, inactive, closed
  createdById String?
  createdBy   User?     @relation("CreatedPlaces", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reviews     Review[]
  photos      Photo[]
}

model Review {
  id           String   @id @default(cuid())
  rating       Int
  comment      String?
  smellLevel   Int
  cleanliness  Int?      // 1-5 rating for cleanliness
  accessibility Int?     // 1-5 rating for accessibility
  placeId      String
  place        Place    @relation(fields: [placeId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Photo {
  id           String   @id @default(cuid())
  url          String
  publicId     String?  // For cloud storage reference
  placeId      String
  place        Place    @relation(fields: [placeId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model Suggestion {
  id          String   @id @default(cuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  address     String?
  city        String   @default("Davao City")
  district    String?
  barangay    String?
  category    String?
  status      String   @default("pending") // pending, approved, rejected
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  adminNotes  String?  // Notes from admin about rejection/approval
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, latitude, longitude]) // Prevent duplicate suggestions
}